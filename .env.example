# ============================================================
# Remote API Test Lab — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# Then run:  npm run env:sync   (generates JWT_SECRET, checks every credential)
#            npm run env:check  (re-check later, changes nothing)
#
# Optional: if you use remote.sh, env:sync also imports your client credentials
# (~/.remote_creds) and a saved company (~/.remote_companies_*), so you don't paste them.
#
# ============================================================

# ── Required for the deployed app ──────────────────────────

# Default environment (overridden by UI selector).
# Options: partners | sandbox
GATEWAY_ENV=partners

# Partner API OAuth client credentials (Partners sandbox).
# https://gateway.partners.remote-sandbox.com
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret

# Partner API OAuth client credentials (Remote sandbox).
# https://gateway.remote-sandbox.com
SANDBOX_CLIENT_ID=your_sandbox_client_id
SANDBOX_CLIENT_SECRET=your_sandbox_client_secret

# Password for the web UI login page.
AUTH_PASSWORD=demo

# JWT signing secret. Generate with: openssl rand -base64 32
# The app will REFUSE to boot if this is unset.
JWT_SECRET=your_jwt_secret_here

# Feature toggle: set to false to hide the contractor (CM) screens (Test Suite,
# Playground) so the app only shows the Payroll (GP) tab. Defaults to shown.
# Baked in at build time: redeploy on Vercel after changing it.
# NEXT_PUBLIC_SHOW_CM=false

# ── Optional — local Vitest runs only ──────────────────────
# These are NOT used by the deployed dashboard. Dashboard users
# connect a company through the UI (Create Fresh / Paste Token).
# Keep these in your local .env so `npm test` still works.

COMPANY_SLUG=your_company_slug
REFRESH_TOKEN=your_refresh_token
SANDBOX_COMPANY_SLUG=your_sandbox_company_slug
SANDBOX_REFRESH_TOKEN=your_sandbox_refresh_token

# ── Optional ───────────────────────────────────────────────
# VERBOSE_LOG=1          # Enable detailed API response logging
