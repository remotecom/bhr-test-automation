# ============================================================
# Test Contractor Demo App — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# All credentials come from your Remote partner dashboard.
# ============================================================

# ── OAuth2 Credentials ──────────────────────────────────────
# Found in: Remote Partner Dashboard → Settings → API Credentials
#
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# ── Refresh Token (required for company-scoped operations) ──
# Found in: Remote Partner Dashboard → Settings → API Credentials
# This grants access to employments, subscriptions, contracts.
# Without it, only partner-level operations work (countries, sandbox).
#
REFRESH_TOKEN=your_refresh_token_here

# ── Company Slug ────────────────────────────────────────────
# The UUID of the company to test against.
# Found in: Remote Partner Dashboard → Companies → click company → URL contains the slug
# Example: 1fef547d-5172-4998-8572-ae33f26ca7aa
#
COMPANY_SLUG=your_company_slug_here

# ── Gateway URL ─────────────────────────────────────────────
# Which Remote environment to connect to.
# Options:
#   https://gateway.partners.remote-sandbox.com  (partner sandbox — recommended)
#   https://gateway.remote-sandbox.com           (main sandbox)
#   https://gateway.niceremote.com               (staging)
#   https://gateway.remote.com                   (production — use with caution)
#
GATEWAY_URL=https://gateway.partners.remote-sandbox.com

# ── Auth (Next.js app) ──────────────────────────────────────
# Password for the web UI login page.
AUTH_PASSWORD=demo

# JWT signing secret. Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# ── Optional ────────────────────────────────────────────────
# VERBOSE_LOG=1          # Enable detailed API response logging
# DASHBOARD_PORT=3939    # Dashboard server port (default: 3939, for legacy local server)
