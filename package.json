{
  "name": "remote-api-test-lab",
  "version": "1.0.0",
  "description": "Remote API Test Lab: test Remote Partner API onboarding flows (contractor products and Global Payroll) against the sandboxes",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cm": "vitest run tests/cm-path.test.ts",
    "test:cm-plus": "vitest run tests/cm-plus-path.test.ts",
    "test:cor": "vitest run tests/cor-path.test.ts",
    "test:cor-ir35": "vitest run tests/cor-ir35-path.test.ts",
    "test:eor": "vitest run tests/eor-fallback-path.test.ts",
    "test:readonly": "vitest run tests/read-only.test.ts",
    "test:gp-unit": "vitest run tests/gp-capabilities.unit.test.ts tests/gp-field-check.unit.test.ts tests/gp-guide.unit.test.ts tests/gp-published-store.unit.test.ts tests/gp-guide-flow.unit.test.ts",
    "test:company-unit": "vitest run tests/company-create.unit.test.ts",
    "gp:capabilities": "npx tsx src/gp/cli.ts",
    "env:sync": "node scripts/env-sync.mjs",
    "env:check": "node scripts/env-sync.mjs --check-only",
    "dev": "next dev",
    "build": "next build",
    "start:next": "next start",
    "start:local": "npx tsx src/dashboard/run.ts",
    "dashboard": "npx tsx src/dashboard/server.ts",
    "start": "npx tsx src/dashboard/run.ts",
    "gp:guide:export": "npx tsx src/gp/guide/cli.ts export",
    "gp:guide:import": "npx tsx src/gp/guide/cli.ts import"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.0.0",
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.8.3",
    "vercel": "^50.42.0",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.1",
    "dotenv": "^17.4.1",
    "exceljs": "^4.4.0",
    "jose": "^6.2.2",
    "jsonwebtoken": "^9.0.2",
    "next": "^16.2.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
